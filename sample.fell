// Fell integration test.
// Successful language behavior belongs here. Invalid programs belong in
// dedicated negative tests.

print("Running Fell integration tests...");

// Boolean values and logical operators.
assert(!false);
assert(true != false);
assert(true == true);
assert(false == false);

// Every numeric type is accepted and survives a typed operation.
let typed_s8 = 1s8 + 2s8;
let typed_s16 = 1s16 + 2s16;
let typed_s32 = 1s32 + 2s32;
let typed_s64 = 1s64 + 2s64;
let typed_u8 = 1u8 + 2u8;
let typed_u16 = 1u16 + 2u16;
let typed_u32 = 1u32 + 2u32;
let typed_u64 = 1u64 + 2u64;
let typed_f32 = 1.0f32 + 2.0f32;
let typed_f64 = 1.0f64 + 2.0f64;
assert(typed_s8 == 3s8);
assert(typed_s16 == 3s16);
assert(typed_s32 == 3s32);
assert(typed_s64 == 3s64);
assert(typed_u8 == 3u8);
assert(typed_u16 == 3u16);
assert(typed_u32 == 3u32);
assert(typed_u64 == 3u64);
assert(typed_f32 == 3.0f32);
assert(typed_f64 == 3.0f64);

// Arithmetic, precedence, unary negation, and comparisons.
assert(2 + 3 * 4 == 14);
assert((2 + 3) * 4 == 20);
assert(-10 + 3 == -7);
assert(10 / 2 == 5);
assert(10 - 3 == 7);
assert(2 < 3);
assert(2 <= 2);
assert(3 > 2);
assert(3 >= 3);
assert(3 != 4);

// Contextual integer typing and lossless numeric conversion.
let min_s8: s8 = -128;
let contextual_u64: u64 = 42;
let widened_s64: s64 = 42s32;
let widened_f64: f64 = 42s32;
assert(min_s8 == -128s8);
assert(contextual_u64 == 42u64);
assert(widened_s64 == 42s64);
assert(widened_f64 == 42.0f64);

// Strings.
assert("Hello, " + "Fell" == "Hello, Fell");
assert("same" == "same");
assert("left" != "right");

// Globals and mutation.
let immutable_global = 42;
let mut health = 100;
health = health - 25;
assert(immutable_global == 42);
assert(health == 75);

// Lexical scopes, locals, and shadowing.
let shadowed = 10;
{
  let local = 20;
  let shadowed = 30;
  assert(local == 20);
  assert(shadowed == 30);
}
assert(shadowed == 10);

// Block expressions.
let block_value = {
  let a = 20;
  let b = 22;
  a + b
};
assert(block_value == 42);

// If / else and conditional expressions.
let mut branch_value = 0;
if true {
  branch_value = 42;
} else {
  branch_value = 1;
}
assert(branch_value == 42);
assert((false ? 0 : 42) == 42);
assert((true ? 42 : 0) == 42);

// Short-circuiting with observable side effects.
let mut and_rhs_evaluated = false;
let mut or_rhs_evaluated = false;
fn touch_and(): bool {
  and_rhs_evaluated = true;
  return true;
}
fn touch_or(): bool {
  or_rhs_evaluated = true;
  return false;
}
assert((false && touch_and()) == false);
assert(and_rhs_evaluated == false);

assert((true || touch_or()) == true);
assert(or_rhs_evaluated == false);

assert((true && touch_and()) == true);
assert(and_rhs_evaluated == true);

assert((false || touch_or()) == false);
assert(or_rhs_evaluated == true);

// While, break, and continue.
let mut while_sum = 0;
let mut while_index = 0;
while while_index < 10 {
  while_index = while_index + 1;
  if while_index == 3 {
    continue;
  }
  if while_index == 8 {
    break;
  }
  while_sum = while_sum + while_index;
}
assert(while_sum == 25);

// For loops, including omitted clauses.
let mut for_sum = 0;
for (let mut i = 0; i < 5; i = i + 1) {
  for_sum = for_sum + i;
}
assert(for_sum == 10);
let mut infinite_for_iterations = 0;
for (;;) {
  infinite_for_iterations = infinite_for_iterations + 1;
  if infinite_for_iterations == 3 {
    break;
  }
}
assert(infinite_for_iterations == 3);

// Switch selection, default, and no implicit fallthrough.
let mut switch_result = 0;
switch 2 {
  case 1 { switch_result = 10; }
  case 2 { switch_result = 20; }
  default { switch_result = 30; }
}
assert(switch_result == 20);
switch 99 {
  case 1 { switch_result = 10; }
  default { switch_result = 30; }
}
assert(switch_result == 30);

// Functions, nested calls, numeric argument conversion, and globals.
fn add(a: s32, b: s32): s32 {
  return a + b;
}
fn add_then_double(a: s32, b: s32): s32 {
  return add(a, b) * 2;
}
fn widen_parameter(value: s64): s64 {
  return value;
}
let global_for_function = 40;
fn read_global(): s32 {
  return global_for_function + 2;
}
assert(add_then_double(10, 11) == 42);
assert(widen_parameter(42s32) == 42s64);
assert(read_global() == 42);

// Forward calls and recursion.
fn call_forward(value: s32): s32 {
  return forward_target(value);
}
fn forward_target(value: s32): s32 {
  return value + 1;
}
fn factorial(n: s32): s32 {
  if n <= 1 {
    return 1;
  }
  return n * factorial(n - 1);
}
assert(call_forward(41) == 42);
assert(factorial(5) == 120);

// Phi-heavy local control flow.
fn choose_phi(value: s32, first: bool, second: bool): s32 {
  let mut result = value;
  if first {
    result = result + 10;
  } else {
    result = result + 20;
  }
  if second {
    result = result * 2;
  } else {
    result = result + 1;
  }
  return result;
}
assert(choose_phi(1, true, true) == 22);
assert(choose_phi(1, true, false) == 12);
assert(choose_phi(1, false, true) == 42);
assert(choose_phi(1, false, false) == 22);

// Loop-carried phi values.
fn sum_to(n: s32): s32 {
  let mut i = 0;
  let mut total = 0;
  while i < n {
    total = total + i;
    i = i + 1;
  }
  return total;
}
assert(sum_to(100) == 4950);

