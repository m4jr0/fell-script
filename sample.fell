let mut health = 100;
let damage = 25;
health = health - damage;
health == 75;

let mut name: string = "Geralt";
name = name + " of Rivia";
name == "Geralt of Rivia";

let mut counter = 0;
while counter < 10 {
  counter = counter + 1;

  if counter == 2 {
    continue;
  }

  if counter == 5 {
    break;
  }

  health = health - 1;
}

let mut total = 0;
for (let mut i = 0; i < 10; i = i + 1) {
  if i == 3 {
    continue;
  }

  if i == 7 {
    break;
  }

  total = total + i;
}

if counter == 5 {
  counter = counter + 10;
} else {
  counter = 0;
}

let is_large = counter > 10 && counter < 100;
let fallback = false || is_large;
let selected = fallback ? counter : 0;

switch selected {
  case 0 {
    counter = 1;
  }
  case 15 {
    counter = counter + 100;
  }
  default {
    counter = 2;
  }
}